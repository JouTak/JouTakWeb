{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:media": "node ./scripts/generate-media.mjs",
    "check:assets": "node ./scripts/check-asset-budgets.mjs",
    "check:audit": "node ./scripts/check-npm-audit.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --cache",
    "lint:styles:fix": "stylelint \"**/*.{css,scss}\" --fix --cache",
    "test": "vitest",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format && npm run lint:styles && npm run test:run && npm run build",
    "prepare": "node ./prepare-husky.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@github/webauthn-json": "^2.1.1",
    "@gravity-ui/navigation": "^6.4.2",
    "@gravity-ui/uikit": "^7.48.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-document-load": "^0.66.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "sharp": "0.35.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "msw@2.13.6": true,
    "esbuild@0.25.9": true,
    "@swc/core@1.10.15": true,
    "sharp@0.35.3": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  }
}
